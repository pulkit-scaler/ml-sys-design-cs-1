# Feed lab settings. Copy to .env and change what you need:  cp .env.example .env
# Every value has a default, so the lab also runs with no .env at all.

# --- Where the lab listens ---------------------------------------------------
# 127.0.0.1 keeps it on this machine. On a cloud VM you open from a browser,
# use 0.0.0.0 and allow the ports in the firewall.
BIND_ADDR=127.0.0.1
FEED_PORT=8080
RETRIEVAL_PORT=8081
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- The data -----------------------------------------------------------------
# The world is KuaiRand-1K, real logs from the Kuaishou app (1,000 users, 4.37 million
# videos). The first start downloads it from Zenodo (1.1 GB, checksum checked) into this
# folder on the host, so it survives `docker compose down -v`. To skip the download, put
# KuaiRand-1K.tar.gz here yourself.
KUAIRAND_DIR=./kuairand
# How many of its videos the feed serves. The build reads the whole dataset either way and
# peaks near 2.8 GB of RAM, so give Docker at least 4 GB. It takes about a minute and a half
# on a 10-core laptop. 200000 builds a smaller index and every demo still works, with
# different numbers.
N_ITEMS=1000000

# --- CPU per service ----------------------------------------------------------
# Fixed CPU limits make latency numbers comparable between machines.
# Docker needs at least FEED + RETRIEVAL + RANKER + 2 CPUs.
FEED_CPUS=1.0
RETRIEVAL_CPUS=2.0
RANKER_CPUS=1.0

# --- Design knobs the demos turn ------------------------------------------------
NPROBE=256                # IVF clusters visited per search (changed live with: python3 lab.py nprobe N)
RANKER_TIMEOUT_MS=80      # deadline for the full ranking model before the light model's order is served
RETRIEVAL_TIMEOUT_MS=60   # deadline for candidate generation before the trending list is served
VARIETY_PENALTY=0.05      # share of the best item's value lost per repeat of a topic (arm B uses double)
RANKER_EXTRA_MS=0         # pretend the ranking model is heavier than it is
