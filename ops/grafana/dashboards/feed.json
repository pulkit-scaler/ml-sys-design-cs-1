{
 "uid": "feedlab",
 "title": "Feed lab",
 "refresh": "5s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "schemaVersion": 39,
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Feed requests / s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(feed_requests_total[15s]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Feed p99 (ms)",
   "description": "Server side. The budget is 200 ms",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(feed_request_seconds_bucket[15s])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Not served by the full ranker (%)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(feed_requests_total{served_by!=\"full\"}[15s])) / sum(rate(feed_requests_total[15s]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "IVF nprobe",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(retrieval_nprobe)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Stream backlog (events)",
   "description": "Actions sent to Kafka that the stream worker has not turned into features yet",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(stream_backlog_events)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Event to feature p99 (ms)",
   "description": "From the app sending an action to the session feature being written, last 15 s with events",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(stream_event_to_feature_seconds_bucket[15s])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Feed latency, server side",
   "description": "Compare with the 200 ms p99 budget",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(feed_request_seconds_bucket[15s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(feed_request_seconds_bucket[15s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "How requests were served",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (served_by) (rate(feed_requests_total[15s]))",
     "legendFormat": "{{served_by}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "p99 per hop",
   "description": "The hop-by-hop budget from the notebook, measured",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ranking_model"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 3
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.99, sum by (le, hop) (rate(feed_hop_seconds_bucket[15s])))",
     "legendFormat": "{{hop}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "ANN search time (two-tower source)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(retrieval_search_seconds_bucket[15s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(retrieval_search_seconds_bucket[15s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Full ranking model, scoring time",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(ranker_score_seconds_bucket[15s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(ranker_score_seconds_bucket[15s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ],
 "tags": [
  "feedlab"
 ]
}